# Copie para .env e ajuste. Nunca versione o .env.
# Valores abaixo servem SOMENTE para desenvolvimento local.

APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# PostgreSQL + PostGIS (container "db")
POSTGRES_USER=climate
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=climate
# Porta no host: 5433 para não conflitar com um PostgreSQL nativo na 5432
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://climate:change-me-local-only@db:5432/climate

# Redis (broker Celery + cache)
REDIS_URL=redis://redis:6379/0

# API
FRONTEND_ORIGIN=http://localhost:3000
READINESS_TIMEOUT_S=5.0

# Frontend: o Next encaminha /api/* para este endereço (rede interna do Docker)
API_INTERNAL_URL=http://backend:8000

# Fontes externas (Fase 2). Deixe vazio até receber o token do INMET.
INMET_TOKEN=

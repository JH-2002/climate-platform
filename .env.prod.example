# Modelo da configuração de produção (spec 011). Copie para .env.prod e preencha.
# Nunca versione o .env.prod. Gere senhas com: openssl rand -base64 32

# Domínio já apontado (DNS) para este servidor. "localhost" testa a pilha na própria máquina.
DOMAIN=clima.exemplo.org
# E-mail para avisos do Let's Encrypt sobre o certificado
ACME_EMAIL=

# Portas publicadas pelo Caddy (no servidor: 80 e 443)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Banco: senha com 16 caracteres ou mais (a API não sobe com senha fraca)
POSTGRES_USER=climate
POSTGRES_PASSWORD=
POSTGRES_DB=climate

# Redis: exige senha na produção
REDIS_PASSWORD=

# Fontes externas
INMET_TOKEN=

# Região e pontos de previsão (os mesmos do .env.example)
REGION_NAME=Município de São Paulo
REGION_BBOX=-46.83,-24.01,-46.36,-23.35
GEOSAMPA_WFS_URL=http://wfs.geosampa.prefeitura.sp.gov.br/geoserver/geoportal/wfs
HTTP_TIMEOUT_S=15

# Limite de requisições por cliente e por minuto (FR-172)
RATE_LIMIT_GENERAL=240
RATE_LIMIT_HEAVY=20

# Mapa (gravados no build do frontend)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_TERRAIN_TILES_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# Backup diário (hora de Brasília) e dias de retenção. BACKUP_ON_START=1 faz um backup ao subir.
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
BACKUP_ON_START=0
